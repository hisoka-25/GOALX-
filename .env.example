# Adresse du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique Supabase utilisée par l’application
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=votre_cle_publique

# Clé privée Supabase — serveur uniquement
# Ne jamais utiliser cette clé dans un fichier contenant "use client"
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Clé Anthropic (Claude) — moteur unique de lecture des captures
# et de verdict automatique des matchs. Serveur uniquement.
ANTHROPIC_API_KEY=votre_cle_anthropic

# (Optionnel) Modèle Claude utilisé pour l’analyse des captures
# ANTHROPIC_MODEL=claude-haiku-4-5

# Nom du compartiment privé contenant les captures
SUPABASE_EVIDENCE_BUCKET=match-evidence

# URL publique de l’application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================
# GENIUSPAY — Agrégateur de paiement (Wave, Orange, MTN,
# Moov, cartes). Clés visibles dans le tableau de bord
# GeniusPay → Paramètres → API.
#
# Modèle actuel de l'API GeniusPay :
#   - une SEULE clé API (étiquetée « sk » dans le dashboard)
#     est envoyée dans le header X-API-Key ;
#   - un secret de signature webhook (étiqueté « ss ») sert
#     à vérifier les notifications de paiement.
# Mode test  : sk_sandbox_... / ss_sandbox_...
# Production : sk_live_...    / ss_live_...
# ⚠️ Ces deux valeurs ne doivent JAMAIS être exposées côté
# client (pas de NEXT_PUBLIC_) — serveur uniquement.
# =========================================================

GENIUSPAY_API_KEY=sk_sandbox_xxxxxxxx
GENIUSPAY_WEBHOOK_SECRET=ss_sandbox_xxxxxxxx
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_ENV=sandbox

# =========================================================
# JEKO (agrégateur Mobile Money CIV — pay-in + pay-out)
# Clés dans le Dashboard Jèko Business → Paramètres → API & Webhooks
# ⚠️ JEKO_API_KEY ne doit JAMAIS être exposée côté client.
# =========================================================
JEKO_API_KEY=jeko_xxxxxxxx
JEKO_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JEKO_STORE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
JEKO_BASE_URL=https://api.jeko.africa
JEKO_WEBHOOK_SECRET=le_secret_webhook_jeko
